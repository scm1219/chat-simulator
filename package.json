{
  "name": "chat-simulator",
  "version": "0.1.0",
  "description": "LLM 角色扮演聊天模拟器",
  "main": "out/main/index.mjs",
  "type": "module",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && npx electron-builder --win",
    "build:mac": "electron-vite build && npx electron-builder --mac",
    "build:linux": "electron-vite build && npx electron-builder --linux",
    "postinstall": "node scripts/rebuild-sqlite.js",
    "rebuild:sqlite": "node scripts/rebuild-sqlite.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "build": {
    "appId": "com.chatsimulator.app",
    "productName": "Chat Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.48",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^13.0.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "better-sqlite3": "^12.11.1",
    "electron": "^41.10.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prebuild-install": "^7.1.3",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  }
}
